# Copy to .env and fill in. .env is gitignored; never commit a key.

# --- Models (required from M2 onward) -----------------------------------------
# Exact ids for the hosted generator and judge. Config-only surface, so a model
# change is an env change, not a code change.
GENERATOR_MODEL=
JUDGE_MODEL=

# standard = sync/async calls, batch = OpenAI /v1/batches JSONL job.
GENERATOR_MODE=standard
JUDGE_MODE=batch

# Leave unset unless the model accepts it. Reasoning models (gpt-6-luna) reject
# temperature=0 and accept only their default, so setting 0 there turns every request
# into an HTTP 400. Set to 0 elsewhere for reproducible sampling.
# GENERATOR_TEMPERATURE=0

# --- Credentials ---------------------------------------------------------------
OPENAI_API_KEY=
# Set only to route through a proxy; leave blank for the provider default.
OPENAI_BASE_URL=

# --- Data ----------------------------------------------------------------------
# Directory holding dev.json and dev_databases/<db_id>/<db_id>.sqlite
DATA_DIR=./data/bird
SUBSET_PATH=./subset.yaml

# --- Execution budget ----------------------------------------------------------
MAX_CONCURRENCY=8
SQL_TIMEOUT_SECONDS=5
MAX_ROWS=1000

# --- Metrics -------------------------------------------------------------------
LABEL_SAMPLE_SIZE=50

# --- Tracing -------------------------------------------------------------------
# Off by default so a run is reproducible without an account. Tracing also stays off
# unless an API key is present, so it cannot be half-enabled by accident.
LANGSMITH_TRACING=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=nl2sql-eval-harness
